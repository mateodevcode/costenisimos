# --- Núcleo (obligatorias) ---
MONGODB_URI=
# URL pública de la app, sin barra final (ej. https://carta.midominio.com). Se usa para CSRF y correos.
APP_URL=
# Secretos JWT: al menos 32 caracteres, distintos entre sí.
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Imágenes (AWS S3) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Prefijo de carpeta dentro del bucket, uno por restaurante (ej. costenisimos)
AWS_S3_FOLDER=
# URL pública base de los objetos, sin barra final (CloudFront o https://<bucket>.s3.<region>.amazonaws.com)
AWS_S3_PUBLIC_URL=

# --- Correo (Brevo SMTP) ---
BREVO_SMTP_EMAIL=
BREVO_SMTP_PASS=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# --- Seed ---
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

